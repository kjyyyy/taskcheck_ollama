# Construction TaskCheck Assistant Environment Variables

# LangSmith Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=construction-taskcheck

# Ollama Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
MODEL_NAME=mistral-construction-uk

# OpenRouter Configuration (for fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_PORT=5000

# Evaluation Configuration
EVAL_ENABLED=true
EVAL_LOG_LEVEL=INFO
EVAL_RESULTS_DIR=eval_results

# Construction Assistant Configuration
CONSTRUCTION_CONTEXT_DIR=context
CONSTRUCTION_UPLOAD_FOLDER=uploads
CONSTRUCTION_MAX_FILE_SIZE=16777216  # 16MB
CONSTRUCTION_ALLOWED_EXTENSIONS=pdf,docx,txt 